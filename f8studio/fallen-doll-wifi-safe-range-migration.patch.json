{
  "label": "Separate full-range simulation from safe-range Wi-Fi output",
  "ops": [
    {
      "op": "disconnectPorts",
      "fromNodeId": "fd_tcode",
      "fromPort": "tcode[D]",
      "toNodeId": "fd_wifi_out",
      "toPort": "[D]value"
    },
    {
      "op": "createNode",
      "nodeType": "f8.pyengine.f8.range_map",
      "nodeId": "fd_device_range",
      "name": "FD Device L0 Safe Range (40-60%)",
      "pos": [2570, 920]
    },
    {
      "op": "createNode",
      "nodeType": "f8.pyengine.f8.tcode",
      "nodeId": "fd_device_tcode",
      "name": "FD Device TCode Encoder",
      "pos": [2860, 920]
    },
    {
      "op": "moveNode",
      "nodeId": "fd_wifi_out",
      "pos": [3150, 920]
    },
    {"op":"setNodeState","nodeId":"fd_device_range","field":"svcId","value":"fd_pyengine"},
    {"op":"setNodeState","nodeId":"fd_device_range","field":"inMin","value":0.0},
    {"op":"setNodeState","nodeId":"fd_device_range","field":"inMax","value":1.0},
    {"op":"setNodeState","nodeId":"fd_device_range","field":"outMin","value":0.4},
    {"op":"setNodeState","nodeId":"fd_device_range","field":"outMax","value":0.6},
    {"op":"setNodeState","nodeId":"fd_device_range","field":"curve","value":"LINEAR"},
    {"op":"setNodeState","nodeId":"fd_device_tcode","field":"svcId","value":"fd_pyengine"},
    {"op":"setNodeState","nodeId":"fd_device_tcode","field":"intervalMs","value":20},
    {
      "op": "connectPorts",
      "fromNodeId": "fd_l0_limit",
      "fromPort": "value[D]",
      "toNodeId": "fd_device_range",
      "toPort": "[D]value"
    },
    {
      "op": "connectPorts",
      "fromNodeId": "fd_device_range",
      "fromPort": "value[D]",
      "toNodeId": "fd_device_tcode",
      "toPort": "[D]L0"
    },
    {
      "op": "connectPorts",
      "fromNodeId": "fd_device_tcode",
      "fromPort": "tcode[D]",
      "toNodeId": "fd_wifi_out",
      "toPort": "[D]value"
    }
  ]
}
