+    def _viewer_open(self, params: dict[str, Any]) -> dict[str, Any]:
+        """Open one Studio-owned detached viewer on the Qt thread."""
+        viewer = self._resolve_viewer(params)
+        was_open = viewer.viewer_is_open()
+        is_open = viewer.open_viewer()
+        return self._viewer_result(viewer, already_open=was_open, viewer_open=is_open)
+
+    def _viewer_close(self, params: dict[str, Any]) -> dict[str, Any]:
+        viewer = self._resolve_viewer(params)
+        was_open = viewer.viewer_is_open()
+        is_open = not viewer.close_viewer()
+        return self._viewer_result(viewer, already_open=was_open, viewer_open=is_open)
+
+    def _viewer_status(self, params: dict[str, Any]) -> dict[str, Any]:
+        viewer = self._resolve_viewer(params)
+        return self._viewer_result(viewer, already_open=viewer.viewer_is_open(), viewer_open=viewer.viewer_is_open())
+
+    def _resolve_viewer(self, params: dict[str, Any]) -> Any:
+        from f8pystudio.render_nodes.viz_three_d import VizThreeDRenderNode
+        from f8pystudio_ext_viz_tcode.render_nodes.viz_tcode import VizTCodeRenderNode
+
+        viewer_types = (VizThreeDRenderNode, VizTCodeRenderNode)
+
+        requested_node_id = str(params.get("nodeId") or "").strip()
+        if requested_node_id:
+            node = self._graph.get_node_by_id(requested_node_id)
+            if node is None:
+                raise ValueError(f"unknown nodeId: {requested_node_id}")
+            if not isinstance(node, viewer_types):
+                raise ValueError(f"node is not a supported detached viewer: {requested_node_id}")
+            return node
+
+        candidates = [node for node in list(self._graph.all_nodes() or []) if isinstance(node, viewer_types)]
+        if not candidates:
+            raise ValueError("the current graph contains no supported detached viewer")
+        if len(candidates) != 1:
+            node_ids = sorted(str(node.id) for node in candidates)
+            raise ValueError(f"multiple detached viewers found; specify --node-id from: {', '.join(node_ids)}")
+        return candidates[0]
+
+    @staticmethod
+    def _viewer_result(viewer: Any, *, already_open: bool, viewer_open: bool) -> dict[str, Any]:
+        return {
+            "nodeId": str(viewer.id),
+            "name": str(viewer.name() or ""),
+            "viewerOpen": bool(viewer_open),
+            "alreadyOpen": bool(already_open),
+        }
+
+    def _graph_focus_node(self, params: dict[str, Any]) -> dict[str, Any]:
+        node_id = _required_text(params, "nodeId")
+        if self._graph.get_node_by_id(node_id) is None:
+            raise ValueError(f"unknown nodeId: {node_id}")
+        self._main_window._focus_node_by_id(node_id)
+        self._main_window.show()
+        self._main_window.raise_()
+        self._main_window.activateWindow()
+        return {"nodeId": node_id, "focused": True}
+
     def _modding_service(self) -> ModdingAutomationService:
         service = self._modding
         if service is None:
