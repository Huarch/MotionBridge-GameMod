From 908495eb60be206409bdde61d38901186b4af204 Mon Sep 17 00:00:00 2001
From: huarch <huarch97@outlook.com>
Date: Mon, 24 Aug 2026 17:09:16 +0800
Subject: [PATCH] feat(tcode): expose all SR6 graph inputs

---
 packages/f8pyengine/f8pyengine/operators/tcode.py           | 2 +-
 packages/f8pyengine/tests/test_output_operator_contracts.py | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/packages/f8pyengine/f8pyengine/operators/tcode.py b/packages/f8pyengine/f8pyengine/operators/tcode.py
index 2009fd0..589ddd0 100644
--- a/packages/f8pyengine/f8pyengine/operators/tcode.py
+++ b/packages/f8pyengine/f8pyengine/operators/tcode.py
@@ -105,7 +105,7 @@ TCodeRuntimeNode.SPEC = F8OperatorSpec(
                 name=axis,
                 description=f"Axis {axis} (0..1).",
                 valueSchema=number_schema(minimum=0.0, maximum=1.0),
-                showOnNode=True if i == 0 else False,
+                showOnNode=i < 6,
             )
             for i, axis in enumerate(AXES)
         ],
diff --git a/packages/f8pyengine/tests/test_output_operator_contracts.py b/packages/f8pyengine/tests/test_output_operator_contracts.py
index 858e779..719a2d7 100644
--- a/packages/f8pyengine/tests/test_output_operator_contracts.py
+++ b/packages/f8pyengine/tests/test_output_operator_contracts.py
@@ -45,6 +45,12 @@ def test_tcode_axes_accept_normalized_values() -> None:
         _assert_normalized_number_port(TCodeRuntimeNode, axis)
 
 
+def test_tcode_exposes_all_sr6_axes_on_the_graph_node() -> None:
+    visible = {str(port.name) for port in TCodeRuntimeNode.SPEC.dataInPorts or [] if port.showOnNode is True}
+    assert {"L0", "L1", "L2", "R0", "R1", "R2"} <= visible
+    assert {"V0", "V1", "A0", "A1"}.isdisjoint(visible)
+
+
 def test_sensitive_output_configuration_is_redacted_on_publish() -> None:
     assert _state_spec(LovenseOutRuntimeNode, "commandUrl").redactOnPublish is True
     assert _state_spec(ButtplugOutRuntimeNode, "wsUrl").redactOnPublish is True
-- 
2.55.0.windows.3

